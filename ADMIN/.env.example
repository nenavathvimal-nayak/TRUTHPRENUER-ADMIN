# Public Client Variables (VITE_ prefix)
# NEVER put SUPABASE_SERVICE_ROLE_KEY or backend server secrets here!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
# Local Privileged Admin API is strictly bound to http://127.0.0.1:60136
VITE_BACKEND_URL=http://127.0.0.1:60136
